// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String   @unique
  code      String?
  // One-time reset token (hashed) and expiry
  resetToken        String?
  resetTokenExpires DateTime?
}

model Progression {
  id          Int      @id @default(autoincrement())
  clientId    String   // Can be numeric ID or string (offline users)
  bookId      Int
  pageId      Int      // Current page
  highestPage Int      @default(0) // Highest page reached (for progress bar)
  percentage  Int      @default(0) // 0-100
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([clientId, bookId])
  @@index([clientId])
  @@index([bookId])
}

model Savepoint {
  id        Int      @id @default(autoincrement())
  clientId  String   // Can be numeric ID or string (offline users)
  bookId    Int
  pageId    Int
  title     String?
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([bookId])
}