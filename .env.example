# Environment variables for Backend
# Copy this file to .env and update with your values

# Application Environment
NODE_ENV=production

# Backend Port
PORT=3012

# Database Configuration
# For SQLite (file-based database)
DATABASE_URL="file:./prisma/clients.db"

# For production, you might want to use PostgreSQL instead:
# DATABASE_URL="postgresql://user:password@localhost:5432/boekenwurmen?schema=public"

# JWT Authentication
# NEVER PUT REAL SECRETS HERE, always use .env for real secrets
JWT_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# LibreTranslate Configuration
LIBRETRANSLATE_URL="http://localhost:5000"

# Translation cache configuration
TRANSLATION_CACHE_MAX_SIZE="1000"

# Source language for book content (ISO 639-1 code)
TRANSLATION_SOURCE_LANG="nl"